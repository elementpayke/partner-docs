{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Element Pay Partner API",
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "navbar": {
    "links": [
      {
        "label": "Compliance",
        "href": "mailto:compliance@elementpay.net"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API access",
      "href": "https://console.elementpay.net"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "orders/quote-and-accept",
              "authentication",
              "webhooks",
              "errors"
            ]
          },
          {
            "group": "Customer KYC",
            "pages": [
              "customers/quickstart",
              "customers/route-cheat-sheet"
            ]
          },
          {
            "group": "Banking",
            "pages": [
              "customers/accounts",
              "customers/deposit-instructions",
              "customers/stablecoin-sends",
              "customers/book-transfers",
              "customers/payouts",
              "customers/cards"
            ]
          },
          {
            "group": "Corridors",
            "pages": [
              "corridors/overview",
              "corridors/kenya",
              "corridors/nigeria",
              "corridors/uganda"
            ]
          },
          {
            "group": "Sandbox",
            "pages": [
              "sandbox/onboarding",
              "sandbox/success-failure",
              "sandbox/test-payloads"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Partner API",
            "openapi": {
              "source": "/api-reference/openapi.json",
              "directory": "api-reference"
            }
          }
        ]
      }
    ]
  },
  "api": {
    "baseUrl": "https://sandbox.elementpay.net/api/v1",
    "auth": {
      "method": "key",
      "name": "X-API-Key"
    },
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "defaults": "required",
      "prefill": true
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/elementpayke"
    }
  }
}
