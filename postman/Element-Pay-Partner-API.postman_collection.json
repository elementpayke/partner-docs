{
  "info": {
    "name": "Element Pay Partner API",
    "description": "African fiat corridors — discovery, quote, accept. Import into Postman and set `base_url` + `api_key` variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{api_key}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "https://sandbox.elementpay.net/api/v1" },
    { "key": "api_key", "value": "is_test_YOUR_KEY" },
    { "key": "quote_id", "value": "" }
  ],
  "item": [
    {
      "name": "Discovery",
      "item": [
        {
          "name": "GET catalog (KE OnRamp)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/partner/catalog?country=KE&order_type=OnRamp"
          }
        },
        {
          "name": "GET corridors",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/partner/corridors"
          }
        },
        {
          "name": "GET payment-methods (KE)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/partner/payment-methods?country=KE&currency=KES&order_type=OnRamp"
          }
        },
        {
          "name": "GET order-requirements (KE OnRamp)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/partner/order-requirements?country=KE&currency=KES&order_type=OnRamp"
          }
        },
        {
          "name": "GET banks (KE bank OnRamp)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/partner/banks?country=KE&currency=KES&order_type=OnRamp&payment_method_type=bank"
          }
        },
        {
          "name": "GET rates indicative",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/partner/rates/indicative?fiat=KES,NGN,UGX"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "POST quote (KE momo OnRamp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.data && j.data.quote_id) {",
                  "  pm.collectionVariables.set('quote_id', j.data.quote_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_type\": \"OnRamp\",\n  \"currency\": \"KES\",\n  \"country\": \"KE\",\n  \"local_amount\": 800,\n  \"asset\": {\n    \"token\": \"0x833589fcd6edb6e08f4c7c32d4f71b54bdA02913\",\n    \"currency\": \"USDC\",\n    \"network\": \"BASE\"\n  },\n  \"customer\": {\n    \"uid\": \"postman-ke-001\",\n    \"type\": \"user\",\n    \"name\": \"Jane Doe\",\n    \"country\": \"KE\",\n    \"phone\": \"+2541111111111\",\n    \"address\": \"Nairobi\",\n    \"dob\": \"02/01/1997\",\n    \"email\": \"jane@example.com\",\n    \"id_number\": \"A1234567\",\n    \"id_type\": \"passport\"\n  },\n  \"payment_method\": {\n    \"type\": \"mobile_money\",\n    \"phone_number\": \"+2541111111111\",\n    \"network_id\": \"7ea6df5c-6bba-46b2-a7e6-f511959e7edb\"\n  },\n  \"wallet_address\": \"0xde0B295669a9FD93d5F28D9Ec85E40f4cb697BAe\"\n}"
            },
            "url": "{{base_url}}/partner/orders/quote"
          }
        },
        {
          "name": "POST accept quote",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/partner/orders/{{quote_id}}/accept"
          }
        }
      ]
    }
  ]
}
